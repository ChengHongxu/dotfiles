# ~/.zshrc —— 由 chezmoi 管理，源文件：$(chezmoi source-path ~/.zshrc)
# 本机私有配置、密钥（API key 等）请写到 ~/.zshrc.local，该文件不进仓库。

# PATH 主要在 ~/.zshenv 里设置；这里再前置一次，是因为 macOS 登录 shell 的
# /etc/zprofile（path_helper）会把系统路径挪到最前面
typeset -U path PATH
path=("$HOME/.pixi/bin" "$HOME/.local/bin" $path)

# ---- oh-my-zsh ----
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""                              # 提示符交给 starship
zstyle ':omz:update' mode disabled        # 由 chezmoi external 负责更新
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
fpath=("$HOME/.pixi/completions/zsh" $fpath)   # pixi global 工具自带的补全
source "$ZSH/oh-my-zsh.sh"

# ---- 工具初始化 ----
eval "$(starship init zsh)"
eval "$(pixi completion --shell zsh)"
# setproxy / venv 的 init 子命令会检查 ~/.zshrc 里有没有它们的 eval 行，没有就追加（会改到仓库里的本文件），
# 所以这两行要留在 ~/.zshrc 本身，内容保持原样（缩进不影响判断）
if (( $+commands[setproxy] )); then
  eval "$(setproxy hook zsh)"
fi

# ---- 模块：~/.config/zsh/*.zsh ----
for _f in "$HOME"/.config/zsh/*.zsh(N); do source "$_f"; done
unset _f

[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# venv：Python 环境管理。放在最后，保证环境的 bin 排在 PATH 最前；嵌套 shell 沿用父 shell 的环境。
# 新 shell 自动激活某个环境：在本机的 ~/.config/venv/config.toml 写 auto_activate = "<名字>"
if (( $+commands[venv] )); then
  eval "$(venv hook zsh)"
fi
