# ~/.zshenv —— 所有 zsh 都会读取（包括脚本、`ssh host cmd` 等非交互场景），只放环境变量。
# 交互配置写在 ~/.zshrc。

typeset -U path PATH
path=("$HOME/.pixi/bin" "$HOME/.local/bin" $path)
# 继承了 venv 环境时（脚本、`zsh -c`），让环境的 bin 排在上面的 ~/.pixi/bin 前面。
# 交互 shell 由 ~/.zshrc 里的 venv hook 处理
[[ -n $VENV_NAME ]] && path=("${VIRTUAL_ENV:-$CONDA_PREFIX}/bin" $path)
export PATH
